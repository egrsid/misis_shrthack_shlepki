# Never commit real credentials. Copy this file to .env and fill it in.
YANDEX_API_KEY=your_yandex_ai_studio_api_key_here
YANDEX_CLOUD_FOLDER=your_yandex_cloud_folder_id_here

# Alice AI LLM model and the OpenAI-compatible Yandex AI Studio endpoint.
YANDEX_MODEL=aliceai-llm
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
