<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Partial Info.plist: Xcode merges the generated keys into this file because
	     GENERATE_INFOPLIST_FILE stays YES. It lives outside the Sber/ folder on
	     purpose — that folder is a synchronized group, and a plist inside it would
	     also be copied in as a resource. -->
	<!-- Without this, App Transport Security blocks the plain-http calls to the
	     local FastAPI backend. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Dictation in the support chat. Without both of these iOS kills the app the
	     moment the microphone button is tapped. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон нужен, чтобы описать проблему голосом вместо набора текста.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Распознавание речи превращает ваше голосовое обращение в текст, который вы сможете проверить перед отправкой.</string>
</dict>
</plist>
